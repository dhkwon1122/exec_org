# 복사해서 .env 로 저장 (cp .env.example .env)
# docker compose 도 이 .env 를 읽는다 (docker-compose.yml 의 ${VAR:-기본값} 참고).

# ── 사용자 DB (로그인) — tea-meeting-agenda 의 .env 와 같은 이름·같은 값 ──
# People in SAIT(Researcher-board)가 쓰는 PostgreSQL. app_users 테이블을 읽기 전용으로 사용한다.
# 컨테이너 안에서는 localhost 가 컨테이너 자신이다 — tea-meeting-agenda 에서 쓰는 값을 그대로 복사하면 된다.
#   (a) 호스트에 떠 있는 Postgres:  ...@host.docker.internal:5433/researcher_board
#   (b) People in SAIT 의 postgres 컨테이너: docker-compose.people-net.yml 을 같이 쓰고 ...@db:5432/researcher_board
# 비우면 이 앱 DB 안의 로컬 app_users 를 쓴다 (scripts/create_user.py 로 계정 생성 — 개발/단독 실행용).
# (USER_DATABASE_URL 로 적어도 된다 — 둘 다 있으면 USER_DATABASE_URL 이 우선)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@host.docker.internal:5433/researcher_board
# 'People in SAIT에서 불러오기'로 가져올 임원 직급 (researchers.position 값, 쉼표 구분)
# EXEC_ORG_POSITIONS=사장,부사장,상무,고문,Master,Fellow
# 접속을 허용할 app_users.role (쉼표 구분). 기본: executive_org(임원조직 담당자)
# EXEC_ORG_ROLES=executive_org
# 세션 서명 키 (tea-meeting-agenda 와 같은 이름) — 비우면 data/.flask_secret_key 에 자동 생성
#   python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
# SESSION_LIFETIME_HOURS=8
# SESSION_COOKIE_NAME=exec_org_session   # 같은 서버의 People in SAIT(session)와 겹치지 않게
# 세션 쿠키 Secure 속성은 접속 방식(http/https)에 맞춰 자동으로 정해진다 — SESSION_COOKIE_SECURE 설정은 쓰지 않는다
# TRUSTED_PROXY_COUNT=1         # --profile proxy(nginx) 뒤에서 돌 때 1 — 로그인 시도 제한이 실제 IP 기준이 됨

# ── Docker (docker-compose.yml) ──
# APP_PORT=8502                 # 호스트에 여는 포트 (People in SAIT 8501 과 다르게)
# PROXY_HTTP_PORT=8080          # --profile proxy 일 때
# PROXY_HTTPS_PORT=8443
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=300
# PEOPLE_NETWORK=researcher-board_default   # docker-compose.people-net.yml 사용 시 People in SAIT 네트워크 이름

# ── 업무 기록 DB: 이 앱 전용 PostgreSQL (docker-compose 의 exec-db) ──
# 필수. 영문·숫자로만 (URL 에 그대로 들어감) — 예: openssl rand -hex 24
# 처음 띄운 뒤 바꾸려면 DB 안의 비밀번호도 같이 바꿔야 한다 (ALTER USER exec_org PASSWORD '...')
EXEC_DB_PASSWORD=
# EXEC_DB_PORT=5434            # 백업·점검용 호스트 포트 (127.0.0.1 에만 열림)
# 주의: DATABASE_URL 은 위의 사용자 DB 다. exec-db 대신 다른 PostgreSQL 을 쓸 때만 아래를 적는다.
# (Docker 없이 직접 실행할 때 비우면 data/exec_org.db SQLite)
# EXEC_ORG_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/exec_org

# ── LLM: OpenAI 호환 chat/completions 엔드포인트 (비우면 AI 요약·키워드 기능 꺼짐) ──
# Researcher-board 의 LLM2_API_URL / LLM2_MODEL 이 이미 있으면 그대로 읽으므로 따로 안 적어도 된다.
LLM_API_URL=http://75.12.15.121:8000/v1/chat/completions
LLM_MODEL=thinkingcap
# LLM_API_KEY=                 # 필요할 때만 (Bearer)
# LLM_TIMEOUT=300              # 초
# LLM_MAX_TOKENS=4000          # 추론형 모델은 사고 과정에도 토큰을 쓰므로 넉넉히
# LLM_MAX_CONCURRENT=2         # 동시에 처리할 AI 정리 요청 수

# ── 받은 메일 자동 처리 (POP3) — 비우면 꺼짐. '받은 메일' 화면에서 분류 규칙·추천 확인 ──
# MAIL_POP3_HOST=mail.example.com
# MAIL_POP3_PORT=995              # SSL 이면 995, 아니면 110 (비우면 자동)
# MAIL_POP3_SSL=1                 # 0 이면 평문 POP3
# MAIL_POP3_USER=
# MAIL_POP3_PASSWORD=
# MAIL_POLL_MINUTES=5             # 몇 분마다 확인
# MAIL_SINCE_DAYS=7               # 처음 연결할 때 이보다 오래된 메일은 건너뜀 (0 = 모두)
# MAIL_MAX_PER_RUN=50             # 한 번에 처리할 최대 메일 수 (넘는 옛 메일은 건너뜀)
# MAIL_MAX_ATTACHMENT_MB=30       # 이보다 큰 첨부 파일은 저장하지 않음 (첨부는 data/uploads/mail/ 에 저장, 문서별 판 묶기)
# MAIL_DELETE_FROM_SERVER=0       # 1 이면 가져온 메일을 서버에서 지움 (기본: 남겨 둠)
# MAIL_PEOPLE_SCHEDULE_KEYWORDS=   # 피플팀장 일정 메일을 알아볼 낱말 더하기 (쉼표, 예: 홍길동 팀장) — 기본: 피플팀장
# MAIL_PEOPLE_SCHEDULE_SENDERS=    # 피플팀장 일정을 보내는 주소·이름 (쉼표) — 이 사람이 보낸 일정 메일은 피플팀장 일정
# MAIL_DIRECTOR_SCHEDULE_KEYWORDS= # 원장님 일정 낱말 더하기 — 기본: 원장님·원장실·기관장
# MAIL_DIRECTOR_SCHEDULE_SENDERS=  # 원장님 일정을 보내는 비서실 주소 (쉼표)
# DOC_SUMMARY_IDLE_MINUTES=10     # 사용자 입력이 이 시간(분) 동안 없으면 요약하지 않은 첨부 문서를 AI 로 하나씩 요약 (0 = 끔, LLM 필요)

# ── 메일 보내기 (사내 메일 발송 REST API — People in SAIT 와 같은 설정) ──
# POST {MAIL_API_URL}/mails/send?userId={MAIL_USER_ID}, Bearer 토큰. SMTP 가 아님. 넷 다 있어야 보낼 수 있다.
# MAIL_API_URL=https://mail.internal.example.com   # base URL 만 — /mails/send 는 코드가 붙인다
# MAIL_TOKEN=your-bearer-token
# MAIL_SYSTEM_ID=your-system-id
# MAIL_FROM=exec-org@example.com
# MAIL_USER_ID=people.sait        # 기본값
# MAIL_TIMEOUT=30                 # 초
# MAIL_VERIFY_TLS=true
# MAIL_CA_BUNDLE=/run/secrets/internal-ca.pem
# MAIL_DEFAULT_DOMAIN=samsung.com # 받는 사람을 비우면 본인(로그인 ID@도메인, 사용자 DB 에 메일이 있으면 그 주소)
