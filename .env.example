# 복사해서 .env 로 저장 (cp .env.example .env)
# docker compose 도 이 .env 를 읽는다 (docker-compose.yml 의 ${VAR:-기본값} 참고).

# ── 사용자 DB (로그인) ──
# People in SAIT(Researcher-board)가 쓰는 PostgreSQL. app_users 테이블을 읽기 전용으로 사용한다.
# 비우면 이 앱 DB 안의 로컬 app_users 를 쓴다 (scripts/create_user.py 로 계정 생성 — 개발/단독 실행용).
USER_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# 접속을 허용할 app_users.role (쉼표 구분). 기본: executive_org(임원조직 담당자)
# EXEC_ORG_ROLES=executive_org
# 세션 서명 키 — 비우면 data/.flask_secret_key 에 자동 생성
# FLASK_SECRET_KEY=
# SESSION_LIFETIME_HOURS=8
# SESSION_COOKIE_NAME=exec_org_session   # 같은 서버의 People in SAIT(session)와 겹치지 않게
# SESSION_COOKIE_SECURE=true   # HTTPS(--profile proxy)로 운영할 때 true
# TRUSTED_PROXY_COUNT=1         # --profile proxy(nginx) 뒤에서 돌 때 1 — 로그인 시도 제한이 실제 IP 기준이 됨

# ── Docker (docker-compose.yml) ──
# APP_PORT=8502                 # 호스트에 여는 포트 (People in SAIT 8501 과 다르게)
# PROXY_HTTP_PORT=8080          # --profile proxy 일 때
# PROXY_HTTPS_PORT=8443
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=300
# PEOPLE_NETWORK=researcher-board_default   # docker-compose.people-net.yml 사용 시 People in SAIT 네트워크 이름

# ── DB (비우면 data/exec_org.db SQLite) ──
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/exec_org

# ── LLM: OpenAI 호환 chat/completions 엔드포인트 (비우면 AI 요약·키워드 기능 꺼짐) ──
# Researcher-board 의 LLM2_API_URL / LLM2_MODEL 이 이미 있으면 그대로 읽으므로 따로 안 적어도 된다.
LLM_API_URL=http://75.12.15.121:8000/v1/chat/completions
LLM_MODEL=thinkingcap
# LLM_API_KEY=                 # 필요할 때만 (Bearer)
# LLM_TIMEOUT=300              # 초
# LLM_MAX_TOKENS=4000          # 추론형 모델은 사고 과정에도 토큰을 쓰므로 넉넉히
# LLM_MAX_CONCURRENT=2         # 동시에 처리할 AI 정리 요청 수
